# Copy to .env and fill in. Real environment variables override these.

# --- Generation: OpenRouter (required for the /ask endpoint) ---------------
# One key, every model. Create one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=sk-or-...
# Optional: override the gateway, or set attribution shown on OpenRouter.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_TITLE=Parliament RAG

# --- Models (optional overrides; defaults shown) ---------------------------
PARL_EMBED_MODEL=BAAI/bge-m3
PARL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Generation model — any slug from https://openrouter.ai/models. Switch this to
# change models (e.g. openai/gpt-5, google/gemini-2.5-pro, deepseek/deepseek-chat).
PARL_LLM_MODEL=anthropic/claude-opus-4.8
# Model for the query-answerability gate run before each retrieval
# (parl_rag.router). Cheap and fast by default; override to use a stronger
# judge for routing.
# PARL_LLM_ROUTER_MODEL=anthropic/claude-haiku-4.5

# --- Storage (optional; default to ../data relative to the backend) --------
# LANCEDB_PATH=/abs/path/to/data/lancedb
# LANCEDB_TABLE=turns
# PARL_DATA_DIR=/abs/path/to/data/transcripts

# --- Service ---------------------------------------------------------------
# Origin the Next.js frontend is served from (CORS). Comma-separated allowed.
CORS_ORIGIN=http://localhost:3000
